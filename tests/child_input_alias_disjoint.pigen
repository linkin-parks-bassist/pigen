module producer(input logic clk, input logic reset, output bit[8] buf o);
 logic [7:0] count;
 always_ff @(posedge clk) begin
  if(reset) count<=0;
  else count<=count+1;
  o<=count;
 end
endmodule
module consumer(input logic clk, input logic reset, input bit[8] buf i, output bit[8] buf o);
 always_ff @(posedge clk) o<=i;
endmodule
module slice_top(input wire clk, input wire reset,
 output wire [15:0] data, output wire [1:0] valid, input wire [1:0] ready);
 logic [15:0] input_data;
 producer a(.clk(clk),.reset(reset),.o(b.i));
 producer c(.clk(clk),.reset(reset),.o(d.i));
 consumer b(.clk(clk),.reset(reset),.i(input_data[7:0]),
  .o(data[7:0]),.o_valid(valid[0]),.o_ready(ready[0]));
 consumer d(.clk(clk),.reset(reset),.i(input_data[15:8]),
  .o(data[15:8]),.o_valid(valid[1]),.o_ready(ready[1]));
endmodule
