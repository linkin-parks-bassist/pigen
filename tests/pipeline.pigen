module pipeline(
    input logic clk,
    input logic reset,
    input logic enable,
    input bit[8] buf source,
    output bit[8] buf destination
);
    always_ff @(posedge clk) begin
        if (enable) begin
            pipeline pipe begin
                bit[8] value;
                bit[8] rejoined;
                bit[8] result;
                stage begin
                    value <= source;
                end
                stage begin
                    rejoined <= value;
                end
                stage begin
                    result <= rejoined + 8'd1;
                end
                yield result;
            endpipeline
            destination <= pipe;
        end
    end
endmodule
