module fsm_example
	(
		input logic clk,
		input logic reset,
		input logic start,
		input bit[8] buf source,
		output bit[8] buf destination
	);

	fsm sender @(posedge clk) reset (reset) initial idle
	begin
		state idle:
		begin
			if (start)
				goto send;
		end
		state send:
		begin
			destination <= source;
			if (accepts(destination, source))
				goto idle;
		end
	end
endmodule
