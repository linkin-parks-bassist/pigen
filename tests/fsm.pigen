module fsm_example
	(
		input logic clk,
		input logic reset,
		input logic start,
		input bit[8] buf source,
		output bit[8] buf destination
	);

	fsm @(posedge clk)
	begin
		if (reset)
			goto idle;
		state idle:
		begin
			if (start)
				goto send;
		end
		state send:
			when (destination <= source)
				goto idle;
	end
endmodule
