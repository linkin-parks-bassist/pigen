pipeline signed_pipeline #(
    parameter integer W = 8
) begin
    option skid_step = 0;
    stage add {
        logic signed [W-1:0] left,
        right,
        unsigned [1:0] opcode
    } yields {result} begin
        logic signed [W-1:0] right;
        logic signed [W:0] result = left + right;
        if (opcode == 2'b11) begin
            result = result + 1;
        end
    endstage
    stage finish {renamed_result} yields {forwarded} begin
        wire signed [W:0] forwarded = renamed_result;
    endstage
endpipeline

pipeline skid_controls begin
    stage s1 {logic [7:0] x} yields {logic [7:0] a} begin a = x; endstage
    stage s2 {a} yields {logic [7:0] b} begin b = a; endstage
    stage s3 {b} yields {logic [7:0] c} begin c = b; endstage
    stage s4 {c} yields {logic [7:0] d} begin d = c; no_skid; endstage
endpipeline

pipeline periodic_controls begin
    stage s1 {logic [7:0] x} yields {logic [7:0] a} begin a = x; endstage
    stage s2 {a} yields {logic [7:0] b} begin b = a; endstage
    stage s3 {b} yields {logic [7:0] c} begin c = b; endstage
    stage s4 {c} yields {logic [7:0] d} begin d = c; endstage
endpipeline

pipeline compact_pipeline begin
stage one {x} yields {logic [7:0] y} begin logic [7:0] x; y = x + 1; endstage
endpipeline
