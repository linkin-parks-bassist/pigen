module case_guard
	(
		input logic clk,
		input logic reset,
		input logic select
	);

	bit[8] buf source;
	bit[8] buf stage;

	always_ff @(posedge clk)
	begin
		if (select == 1'b0)
			stage <= source;
		else if (select == 1'b1)
			stage <= source + 8'd1;
		else
			invalidate(stage);
	end
endmodule
