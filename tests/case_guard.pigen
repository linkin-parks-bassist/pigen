module case_guard
	(
		input logic clk,
		input logic reset,
		input logic [1:0] select
	);

	bit[8] buf source;
	bit[8] buf stage;

	always_ff @(posedge clk)
	begin
		unique case (select)
			2'd0: stage <= source;
			2'd1: stage <= source + 1'b1;
			default: invalidate(stage);
		endcase
	end
endmodule
