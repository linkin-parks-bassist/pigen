module producer(input logic clk, input logic reset, output bit[8] buf o);
 logic [7:0] count;
 always_ff @(posedge clk) begin
  if(reset) count<=0;
  else count<=count+1;
  o<=count;
 end
endmodule
module consumer(input logic clk, input logic reset, input bit[8] buf i, output bit[8] buf o);
 always_ff @(posedge clk) o<=i;
endmodule
module endpoint_top(input logic clk, input logic reset, output bit[8] buf result);
 logic [7:-8] wire_data;
 assign wire_data[7:0]=8'ha5; logic wire_valid, wire_ready;
 producer a(.clk(clk),.reset(reset),.o(wire_data[-1:-8]),.o_valid(wire_valid),.o_ready(wire_ready));
 consumer b(.clk(clk),.reset(reset),.i(wire_data[(-32'sd16 >>> 1) +: 8]),.o(result));
endmodule
