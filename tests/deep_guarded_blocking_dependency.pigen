module mixed_deep(input logic clk, input logic en, input logic sub, input bit[8] buf i, output bit[8] buf o, output logic [7:0] temp);
 function automatic logic [7:0] inc(input logic [7:0] x);
  inc = x + 8'd1;
 endfunction
 always_ff @(posedge clk) begin
  if (en) begin
   if (sub) begin
    temp = inc(i);
    o <= temp;
   end
  end
 end
endmodule
