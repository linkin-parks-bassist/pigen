module pchild(input logic clk, input bit[8] buf i, output bit[8] buf o);
 always_ff @(posedge clk) o <= i;
endmodule
module top(input logic clk, input logic [7:0] a, input logic av, output logic ar, output logic [7:0] y, output logic yv, input logic yr);
 pchild c(.clk(clk), .i(a), .i_valid(av), .i_ready(ar), .o(y), .o_valid(yv), .o_ready(yr));
endmodule
