module always_block
	(
		input logic clk,
		input logic reset,
		input logic enable,
		input logic [7:0] ordinary_input,
		output logic [7:0] ordinary_output
	);

	bit[8] buf source;
	bit[8] buf destination;

	/* Non-clocked ordinary SystemVerilog always blocks remain untouched. */
	always @*
		ordinary_output = ordinary_input;

	always @(posedge clk) begin
		if (enable)
			destination <= source;
	end

endmodule
