module mixed_case_nested(input logic clk, input logic [1:0] sel, input bit[8] buf i, output bit[8] buf o, output logic [7:0] temp);
 function automatic logic [7:0] inc(input logic [7:0] x);
  inc = x + 8'd1;
 endfunction
 always_ff @(posedge clk) begin
  case (sel)
   {1'b0,1'b1}, 2'd2: case(i)
 8'd10: temp=inc(i);
 default: temp=inc(8'd40);
 endcase
   default: begin
   end
  endcase
  o <= temp;
 end
endmodule
