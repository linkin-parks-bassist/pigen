module native_marker(input bit a, output bit y);
    bit pipeline;
    bit fabric;
    assign pipeline = a;
    assign fabric = pipeline;
    assign y = fabric;
endmodule

pipeline embedded_pipeline begin
    option skid_step = 0;
    stage pass {logic [7:0] value} yields {value} begin
    endstage
endpipeline

fabric embedded_fabric #(
    parameter integer PAYLOAD_W = 8
) begin
    producer.tx.consumer > consumer.rx;
endfabric
