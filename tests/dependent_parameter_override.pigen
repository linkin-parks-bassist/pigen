module pchild #(parameter W = 8, parameter D = W * 2)(input logic clk, input bit[W] buf i, output bit[W] buf o, output logic [D-1:0] tag);
 always_ff @(posedge clk) o <= i;
 assign tag = 0;
endmodule
module top(input logic clk, input bit[16] buf a, output bit[16] buf y, output logic [31:0] tag);
 pchild #(.W(16)) c(.clk(clk), .i(a), .o(y), .tag(tag));
endmodule
