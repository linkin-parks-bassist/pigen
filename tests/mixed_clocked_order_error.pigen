module mixed_clocked_order_error(input logic clk, input bit[8] buf i, output bit[8] buf o, output logic [7:0] temp);
 logic [7:0] side_effect;
 function automatic logic [7:0] inc(input logic [7:0] x);
  side_effect = x;
  inc = x + 8'd1;
 endfunction
 always_ff @(posedge clk) begin
  temp = inc(i);
  o <= temp;
 end
endmodule
