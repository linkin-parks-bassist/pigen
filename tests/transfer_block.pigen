module transfer_block
(
    input logic clk,
    input logic reset,
    input bit[16] port source
);
    bit[8] buf high;
    bit[8] buf low;
    reg [7:0] history;

    always @(posedge clk) begin
        transfer begin
            high <= source[15:8];
            low <= source[7:0];
            history <= source[7:0];
        end
    end
endmodule
