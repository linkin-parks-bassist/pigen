module ordinary_sv_preserve(input logic clk, input logic [3:0] a, output logic [3:0] y, output logic [3:0] z);
 typedef logic [3:0] nibble_t;
 localparam nibble_t MASK = 4'hf;
 genvar i;
 generate
  for (i = 0; i < 4; i = i + 1) begin : bits
   assign y[i] = a[i];
  end
 endgenerate
 always_comb z = a ^ MASK;
 initial $display("ordinary SV preserved");
endmodule
