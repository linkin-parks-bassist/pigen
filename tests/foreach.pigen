module foreach_core(input logic [7:0] data, output logic [31:0] ordered,
 output logic [31:0] exits, output logic [31:0] skipped, output logic [31:0] nested, output logic [31:0] mixed);
always_comb begin
 logic [7:0] cells[-2:-1][3:1];
 logic [1:0][2:0] packed_bits;
 uint[8] typed_marker;
 int sum;
 int outside;
 typed_marker=0; outside=17; packed_bits=6'(data);
 foreach(cells[i,j]) cells[i][j]=8'(data+i*5+j);
 sum=0;
 foreach(cells[i,j]) begin
  int carry;
  if(i==-2 && j==3) carry=0;
  carry+=int'(cells[i][j]);
  sum=sum*3+carry+i*17+j;
 end
 ordered=32'(sum);
 sum=0;
 foreach(cells[i,j]) begin
  if(i==-2 && j==2) continue;
  if(i==-1 && j==2) break;
  sum=sum*3+int'(cells[i][j]);
 end
 exits=32'(sum);
 sum=0;
 foreach(packed_bits[,j]) sum=sum*7+j+int'(packed_bits[1][j]);
 foreach(cells[i]) sum=sum*7+i;
 skipped=32'(sum);
 sum=0;
 foreach(cells[outside,j]) begin
  foreach(packed_bits[,j]) begin
   if(j==1) continue;
   sum+=outside*11+j;
  end
  for(int k=0;k<4;k++) begin if(k==1) continue; if(k==3) break; sum+=k; end
 end
 nested=32'(sum+outside+int'(typed_marker));
 sum=0;
 foreach(cells[,j,k]) sum=sum*3+j*11+k+int'(cells[-2][j][k]);
 mixed=32'(sum);
end
endmodule
