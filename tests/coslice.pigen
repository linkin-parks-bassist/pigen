module coslice
	(
		input logic clk,
		input logic reset,
		input bit[8] buf source,
		output bit[8] buf left,
		output bit[8] buf right,
		output logic [7:0] history,
		output logic [7:0] previous
	);

	reg [7:0] state;
	reg [3:0] state_delay;

	always_ff @(posedge clk)
	begin
		{left, right, state, state_delay} <= {source, source, source, state[3:0]};
		history <= state;
		previous <= state;
	end
endmodule
