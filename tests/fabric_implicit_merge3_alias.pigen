module merge_leaf(input logic clk, input logic reset, input bit[8] buf i, output bit[8] buf o);
 always_ff @(posedge clk) o<=i;
endmodule
module implicit_merge_top(input logic clk, input logic reset,
 input bit[8] buf s0, input bit[8] buf s1, input bit[8] buf s2, output bit[8] buf result);
 logic [7:0] data0;
 merge_leaf x0(.clk(clk),.reset(reset),.i(s0),.o(data0));
 logic [7:0] data1;
 merge_leaf x1(.clk(clk),.reset(reset),.i(s1),.o(data1));
 logic [7:0] data2;
 merge_leaf x2(.clk(clk),.reset(reset),.i(s2),.o(data2));
 merge_leaf y(.clk(clk),.reset(reset),.o(result));
 fabric begin
  x0.o -> y.i;
  x1.o -> y.i;
  x2.o -> y.i;
 endfabric
endmodule
