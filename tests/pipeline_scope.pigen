module pipeline_scope(
	input logic clk,
	input logic reset,
	input logic enable,
	input logic [7:0] static_source,
	input bit[8] buf wire_source,
	input bit[8] buf first_source,
	input bit[8] buf later_source,
	output bit[8] buf wire_result,
	output bit[8] buf later_result,
	output bit[8] buf static_result
);
	typedef logic [7:0] octet;
	localparam octet STATIC_BIAS = 8'd2;

	always_ff @(posedge clk) begin
		if (enable) begin

			pipeline via_wire begin
				bit[8] wire_value;
				stage begin
					wire_value <= wire_source + 8'd1;
				end
				yield wire_value;
			endpipeline

			pipeline with_later_input begin
				bit[8] first;
				bit[8] second;
				stage begin
					first <= first_source;
				end
				stage begin
					second <= first + later_source;
				end
				yield second;
			endpipeline

			wire_result <= via_wire;
			later_result <= with_later_input;
			static_result <= static_source + 8'd2;
		end
	end
endmodule
