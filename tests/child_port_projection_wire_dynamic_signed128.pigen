module producer(input logic clk, input logic reset, output bit[8] buf o);
 logic [7:0] count;
 always_ff @(posedge clk) begin
  if(reset) count<=0;
  else count<=count+1;
  o<=count;
 end
endmodule
module consumer(input logic clk, input logic reset, input bit[1] buf i, output bit[1] buf o);
 always_ff @(posedge clk) o<=i;
endmodule
module endpoint_top(input logic clk, input logic reset, input logic signed[127:0] selector, output bit[1] buf result);
 logic [-1:-8] wire_data;
 logic wire_valid, wire_ready;
 producer a(.clk(clk),.reset(reset),.o(wire_data),.o_valid(wire_valid),.o_ready(wire_ready));
 consumer b(.clk(clk),.reset(reset),.i(wire_data[selector]),.o(result));
endmodule
