module signed_signal
    (
        input logic clk,
        input logic reset,
        input  logic signed [23:0] buf input_sample,
        output logic signed [23:0] buf output_sample
    );

    logic signed [23:0] buf stage;
    logic signed [23:0] fifo[2] history;
    logic signed [23:0] skid elastic;

    always_ff @(posedge clk)
    begin
        stage <= input_sample;
        history <= stage;
        elastic <= history;
        output_sample <= elastic;
    end
endmodule
