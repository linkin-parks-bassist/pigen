module wide_literals(input wire clk, input wire reset,
 output logic[192:0] buf payload,
 output logic signed[127:0] buf shifted);
 always_ff @(posedge clk) begin
  payload<=193'bz1001100110011001100110011001100110011001100110011001100110011001100110011001100110011001100110011001100110011001100110011001100110011001100110011001100110011001100110011001100110011001100110xz;
  shifted<=128'sh80000000000000000000000000000000 >>> 4;
 end
endmodule
