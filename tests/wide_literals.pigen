module wide_literals(input wire clk, input wire reset,
 output logic[192:0] buf payload,
 output logic signed[127:0] buf shifted);
 localparam logic[128:0] FLAG=129'h100000000000000000000000000000000;
 localparam logic[192:0] DATA=193'bz1001100110011001100110011001100110011001100110011001100110011001100110011001100110011001100110011001100110011001100110011001100110011001100110011001100110011001100110011001100110011001100110xz;
 localparam logic[128:0] FLAG_POS=+FLAG;
 localparam logic[128:0] FLAG_ALIAS=~(~FLAG_POS);
 localparam logic[192:0] DATA_ALIAS=DATA;
 always_ff @(posedge clk) begin
  payload<=DATA_ALIAS;
  shifted<=FLAG_ALIAS ? 128'sh80000000000000000000000000000000 >>> 4 : 0;
 end
endmodule
