module producer(input logic clk, input logic reset, output bit[8] buf o);
 logic [7:0] count;
 always_ff @(posedge clk) begin
  if(reset) count<=0;
  else count<=count+1;
  o<=count;
 end
endmodule
module producer_slow(input logic clk, input logic reset, output bit[8] buf o);
 logic [7:0] count;
 always_ff @(posedge clk) begin
  if(reset) count<=0;
  else count<=count+1;
  if(count[1:0]==2'b00) o<=count;
 end
endmodule
module consumer(input logic clk, input logic reset, input bit[4] buf i, output bit[4] buf o);
 always_ff @(posedge clk) o<=i;
endmodule
module endpoint_top(input logic clk, input logic reset, output bit[4] buf result);
 logic [15:0] wire_data;
 logic wire_valid, wire_ready;
 producer a(.clk(clk),.reset(reset),.o(wire_data[7:0]),.o_valid(wire_valid),.o_ready(wire_ready));
 producer_slow c(.clk(clk),.reset(reset),.o(wire_data[15:8]));
 consumer b(.clk(clk),.reset(reset),.i({wire_data[9:8],wire_data[1:0]}),.o(result));
endmodule
