module producer(input logic clk, input logic reset, output bit[8] buf o);
 logic [7:0] count;
 always_ff @(posedge clk) begin
  if(reset) count<=0;
  else count<=count+1;
  o<=count;
 end
endmodule
module consumer(input logic clk, input logic reset, input bit[8] buf i, output bit[8] buf o);
 always_ff @(posedge clk) o<=i;
endmodule
module endpoint_top(input wire [1:0] permission, input logic clk, input logic reset, output bit[8] buf result);
 logic [7:0] wire_data; logic wire_valid, wire_ready;
 producer a(.clk(clk),.reset(reset),.o(wire_data),.o_valid(wire_valid),.o_ready(permission[0]));
 consumer b(.clk(clk),.reset(reset),.i(a.o),.o(result));
endmodule
