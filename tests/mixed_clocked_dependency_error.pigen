module mixed_clocked_dependency_error(input logic clk, input logic en, input bit[8] buf i, output bit[8] buf o, output logic [7:0] temp);
 function automatic logic [7:0] inc(input logic [7:0] x);
  inc = x + 8'd1;
 endfunction
 always_ff @(posedge clk) begin
  if (en) begin
   temp = inc(i);
   o <= temp;
  end
 end
endmodule
