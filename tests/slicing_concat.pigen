module slicing_concat
	(
		input logic clk,
		input logic reset,
		input bit[4] buf join_high,
		input bit[12] buf join_low,
		output bit[16] buf joined,
		input bit[16] buf whole,
		output bit[6] buf split_high,
		output bit[10] buf split_low,
		input bit[16] buf single_sliced,
		output bit[8] buf selected_byte,
		input bit[16] buf sliced,
		output bit[8] buf slice_high,
		output bit[8] buf slice_low,
		output bit[8] buf constant_high,
		output bit[8] buf constant_low
	);

	always_ff @(posedge clk)
	begin
		joined <= {join_high, join_low};
		{split_high, split_low} <= whole;
		selected_byte <= single_sliced[7:0];
		{slice_high, slice_low} <= {sliced[15:8], sliced[7:0]};
		{constant_high, constant_low} <= 16'hcafe;
	end
endmodule
