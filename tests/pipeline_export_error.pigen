module pipeline_export_error(
	input logic clk,
	input logic [7:0] source,
	output bit[8] buf destination
);
	typedef logic [7:0] octet;
	always_ff @(posedge clk) begin
		pipeline invalid begin
			bit[8] value;
			stage begin
				value <= source;
			end
			export value;
			yield value;
		endpipeline
		destination <= invalid;
	end
endmodule
