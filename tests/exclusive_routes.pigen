module exclusive_routes
	(
		input logic clk,
		input logic reset,
		input logic select
	);

	bit[8] buf source;
	bit[8] buf left;
	bit[8] buf right;
	bit[8] buf merged;

	always_ff @(posedge clk)
	begin
		if (select)
			left <= source;
		else
			right <= source;
		if (select)
			merged <= left;
		else
			merged <= right;
	end
endmodule
