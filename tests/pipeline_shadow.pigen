module pipeline_shadow(
	input logic clk,
	input bit[8] buf source,
	input logic [7:0] value,
	output bit[8] buf destination
);
	typedef logic [7:0] octet;

	always @(posedge clk) begin
		pipeline shadow begin
			octet value, carried;
			stage begin
				wire octet carried = source;
				value <= carried;
			end
			yield value;
		endpipeline
		destination <= shadow;
	end
endmodule
