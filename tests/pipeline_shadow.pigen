module pipeline_shadow(
	input logic clk,
	input bit[8] buf source,
	output bit[8] buf destination
);
	always_ff @(posedge clk) begin
		pipeline shadow begin
			bit[8] value;
			bit[8] value;
			stage begin
				value <= source;
			end
			yield value;
		endpipeline
		destination <= shadow;
	end
endmodule
