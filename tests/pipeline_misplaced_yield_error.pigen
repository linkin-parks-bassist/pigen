module pipeline_misplaced_yield_error(
	input logic clk,
	input bit[8] buf source,
	output bit[8] buf destination
);
	always_ff @(posedge clk) begin
		pipeline misplaced_yield begin
			bit[8] value;
			stage begin
				value <= source;
				yield value;
			end
		endpipeline
		destination <= misplaced_yield;
	end
endmodule
