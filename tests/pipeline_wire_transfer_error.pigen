module pipeline_wire_transfer_error(
	input logic clk,
	input logic [7:0] source,
	output bit[8] buf destination
);
	always_ff @(posedge clk) begin
		pipeline invalid begin
			bit[8] value;
			stage begin
				source <= value;
				value <= source;
			end
			yield value;
		endpipeline
		destination <= invalid;
	end
endmodule
