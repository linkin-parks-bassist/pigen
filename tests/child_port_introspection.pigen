module producer(input logic clk, input logic reset, output bit[8] buf o);
 logic [7:0] count;
 always_ff @(posedge clk) begin
  if(reset) count<=0;
  else count<=count+1;
  o<=count;
 end
endmodule
module consumer(input logic clk, input logic reset, input bit[8] buf i, output bit[8] buf o);
 always_ff @(posedge clk) o<=i;
endmodule
module endpoint_top(input logic clk, input logic reset, output bit[8] buf result, output logic seen_valid, output logic seen_ready, output logic [7:0] seen_payload);
 logic [7:0] wire_data; logic wire_valid, wire_ready;
 producer a(.clk(clk),.reset(reset),.o(wire_data),.o_valid(wire_valid),.o_ready(wire_ready));
 always_ff @(posedge clk) begin
  result <= a.o;
  seen_valid <= valid(a.o);
  seen_ready <= ready(a.o);
  seen_payload <= peek(a.o);
 end
endmodule
