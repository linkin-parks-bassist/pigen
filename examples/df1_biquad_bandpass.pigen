module df1_biquad_bandpass (
    input wire clk,
    input wire reset,
    input int[24] buf sample,
    output int[24] buf filtered
);
    int[24] reg x1, x2, y1, y2;
    int[64] wire mac, shifted;
    int[24] wire y_next;

    // Q1.23 samples; Q4.20 filter coefficients.
    assign mac = 191477 * sample - 191477 * x2
               + 1849065 * y1 - 952838 * y2;
    assign shifted = mac >>> 20;
    assign y_next = shifted > 8388607 ? 8388607 :
                   (shifted < -8388608 ? -8388608 : shifted);

    always @(posedge clk) begin
        if (reset) begin
            x1 <= 0;
            x2 <= 0;
            y1 <= 0;
            y2 <= 0;
        end else begin
            // One atomic transfer: consume a sample, emit a result,
            // and advance all filter history together.
            {filtered, x1, x2, y1, y2} <=
                {y_next, sample, x1, y_next, y1};
        end
    end
endmodule
