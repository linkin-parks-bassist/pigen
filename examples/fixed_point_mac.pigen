module fixed_point_mac
	(
		input logic clk,
		input logic reset,
		input logic [15:0] buf sample,
		input logic [15:0] buf coefficient,
		input logic [15:0] buf bias,
		output logic [15:0] buf result
	);

	logic [31:0] buf product;

	always_ff @(posedge clk)
	begin
		// 8.8 fixed point: (sample * coefficient) >> 8, then add bias.
		product <= sample * coefficient;
		result <= product[23:8] + bias;
	end

endmodule
