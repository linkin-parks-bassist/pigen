module df1_biquad_bandpass (
		input logic clk,
		input logic reset,

		input  int[24] buf data_in,
		output int[24] port data_out
	);

	int[24] buf hold;
	int[24] buf x1;

	int[51] buf acc_1;
	int[51] buf acc_2;

	always_ff @(posedge clk) begin
		if (reset) begin
			hold <= 0; validate(hold);
		end else begin
			{hold, acc_1} <= {data_in, data_in * 3};

			x1 <= hold;

			acc_2 <= acc_1 + x1 * 12;

			data_out <= acc_2;
		end
	end

endmodule
