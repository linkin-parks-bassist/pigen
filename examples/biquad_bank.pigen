`define DATA_WIDTH 		16
`define DATA_INTBIT		1
`define COEF_WIDTH 		18
`define COEF_INTBIT		4
`define N_SLOTS			8
`define ACC_WIDTH		(`DATA_WIDTH + `COEF_WIDTH + 3)
`define HANDLE_WIDTH	3

typedef struct packed {
	logic        [`HANDLE_WIDTH - 1:0] handle;
	logic signed [`DATA_WIDTH   - 1:0] sample;
} biquad_req;

typedef struct packed {
	logic        [`HANDLE_WIDTH   - 1:0] handle;
	logic signed [`COEF_WIDTH * 5 - 1:0] coefs;
} biquad_coef_write_req;

module biquad_pipeline
	(
		input logic clk,
		input logic reset,
		input logic enable,

		input  biquad_req buf req_in,
		output logic signed [15:0] buf bqd_out,
		input  biquad_coef_write_req buf coef_write_port
	);

	logic signed [`COEF_WIDTH * 5 - 1:0] coef_mem [`N_SLOTS - 1:0];
	logic signed [`DATA_WIDTH * 4 - 1:0] state_mem [`N_SLOTS - 1:0];
	logic [`N_SLOTS - 1:0] coefs_valid, state_valid;

	localparam logic signed [17:0] coef_1 = 18'sd8192;
	localparam logic signed [17:0] coef_0 = 18'sd0;
	localparam logic signed [`COEF_WIDTH * 5 - 1:0] trivial_coefs =
		{coef_1, coef_0, coef_0, coef_0, coef_0};
	localparam logic signed [`DATA_WIDTH * 4 - 1:0] zero_state = 0;

	logic signed [36:0] mac;
	logic signed [15:0] y_next;
	logic [`DATA_WIDTH * 4 - 1:0] next_state;

	assign mac =
		$signed({{19{coef_mem[req_in[18:16]][89]}}, coef_mem[req_in[18:16]][89:72]}) *
			$signed({{21{req_in[15]}}, req_in[15:0]}) +
		$signed({{19{coef_mem[req_in[18:16]][71]}}, coef_mem[req_in[18:16]][71:54]}) *
			$signed({{21{state_mem[req_in[18:16]][63]}}, state_mem[req_in[18:16]][63:48]}) +
		$signed({{19{coef_mem[req_in[18:16]][53]}}, coef_mem[req_in[18:16]][53:36]}) *
			$signed({{21{state_mem[req_in[18:16]][47]}}, state_mem[req_in[18:16]][47:32]}) +
		$signed({{19{coef_mem[req_in[18:16]][35]}}, coef_mem[req_in[18:16]][35:18]}) *
			$signed({{21{state_mem[req_in[18:16]][31]}}, state_mem[req_in[18:16]][31:16]}) +
		$signed({{19{coef_mem[req_in[18:16]][17]}}, coef_mem[req_in[18:16]][17:0]}) *
			$signed({{21{state_mem[req_in[18:16]][15]}}, state_mem[req_in[18:16]][15:0]});
	assign y_next = $signed(mac) >>> 13;
	assign next_state = {req_in[15:0],
		state_mem[req_in[18:16]][63:48],
		y_next,
		state_mem[req_in[18:16]][31:16]};

	always_ff @(posedge clk)
	begin
		if (reset)
		begin
			coefs_valid <= 8'd0;
			state_valid <= 8'd0;
			coef_mem[0] <= {18'sd8192, 18'sd0, 18'sd0, 18'sd0, 18'sd0};
			coef_mem[1] <= {18'sd8192, 18'sd0, 18'sd0, 18'sd0, 18'sd0};
			coef_mem[2] <= {18'sd8192, 18'sd0, 18'sd0, 18'sd0, 18'sd0};
			coef_mem[3] <= {18'sd8192, 18'sd0, 18'sd0, 18'sd0, 18'sd0};
			coef_mem[4] <= {18'sd8192, 18'sd0, 18'sd0, 18'sd0, 18'sd0};
			coef_mem[5] <= {18'sd8192, 18'sd0, 18'sd0, 18'sd0, 18'sd0};
			coef_mem[6] <= {18'sd8192, 18'sd0, 18'sd0, 18'sd0, 18'sd0};
			coef_mem[7] <= {18'sd8192, 18'sd0, 18'sd0, 18'sd0, 18'sd0};
			state_mem[0] <= 64'sd0;
			state_mem[1] <= 64'sd0;
			state_mem[2] <= 64'sd0;
			state_mem[3] <= 64'sd0;
			state_mem[4] <= 64'sd0;
			state_mem[5] <= 64'sd0;
			state_mem[6] <= 64'sd0;
			state_mem[7] <= 64'sd0;
		end
		else if (enable)
		begin
			if (valid(coef_write_port))
			begin
				{coef_mem[coef_write_port.handle],
				 coefs_valid[coef_write_port.handle]} <=
					{coef_write_port.coefs, 1'b1};
			end

			if (valid(req_in))
			begin
				bqd_out <= y_next;
				{state_mem[req_in.handle], state_valid[req_in.handle]} <=
					{next_state, 1'b1};
			end
		end
	end

endmodule
