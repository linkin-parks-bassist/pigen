// LSB-first UART, 5..9 data bits, optional even/odd parity, 1/2 stop bits.
// PARITY: 0=none, 1=even, 2=odd. CLKS_PER_BIT >= 4.
module pigen_uart_tx #(
    parameter int[32] CLKS_PER_BIT = 16,
    parameter int[32] DATA_BITS = 8,
    parameter int[32] PARITY = 0,
    parameter int[32] STOP_BITS = 1
) (
    input wire clk,
    input wire reset,
    input bit[DATA_BITS] buf data,
    output bit reg tx
);
    initial if (CLKS_PER_BIT < 4 || DATA_BITS < 5 || DATA_BITS > 9 ||
                PARITY < 0 || PARITY > 2 || STOP_BITS < 1 || STOP_BITS > 2)
        $fatal(1, "UART requires CLKS_PER_BIT >= 4, DATA_BITS 5..9, PARITY 0..2, STOP_BITS 1..2");
    localparam int[32] FRAME_BITS = DATA_BITS + STOP_BITS + 1 + (PARITY == 0 ? 0 : 1);

    bit[FRAME_BITS] reg frame;
    int[32] reg timer;
    int[5] reg remaining;

    fsm @(posedge clk) begin
        if (reset) begin
            tx <= 1;
            goto idle;
        end
        state idle:
            when (frame <= PARITY == 0 ? {2'b11, data, 1'b0} :
                {2'b11, ((^data) ^ (PARITY == 2)), data, 1'b0}) begin
                timer <= CLKS_PER_BIT - 1;
                remaining <= FRAME_BITS;
                goto send;
            end
        state send: begin
            tx <= frame[0];
            if (timer == 0) begin
                if (remaining == 1) goto idle;
                frame <= frame >> 1;
                remaining <= remaining - 1;
                timer <= CLKS_PER_BIT - 1;
            end else timer <= timer - 1;
        end
    end
endmodule
