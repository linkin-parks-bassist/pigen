module pipeline_misplaced_yield_error(
	input logic clk,
	input buf [7:0] source,
	output buf [7:0] destination
);
	always @(posedge clk) begin
		pipeline misplaced_yield begin
			logic [7:0] value;
			stage begin
				value <= source;
				yield value;
			end
		endpipeline
		destination <= misplaced_yield;
	end
endmodule
